# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/learnsphere
# For SQLite (development): DATABASE_URL=sqlite:///./learnsphere.db

# Security
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string

# AI Service
GROQ_API_KEY=your-groq-api-key-here

# Optional: OpenAI (if using instead of Groq)
# OPENAI_API_KEY=your-openai-api-key

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
FRONTEND_PORT=8501

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379

# Email (optional, for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production
